# Database Connection
# For Railway: copy the DATABASE_URL from your Railway service dashboard
# For local development: use your local PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/wagh_rental_db"

# Gmail Integration (optional — for auto-scanning emails)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/api/gmail/callback

# Claude Chat (optional — for AI chat feature)
ANTHROPIC_API_KEY=

# API authentication — any long random string; must match VITE_API_KEY in the frontend build env.
# Generate one with: openssl rand -hex 32
# If unset, the API is open (local dev only — always set this in production).
API_KEY=

# Frontend URL (for OAuth redirect in production)
FRONTEND_URL=http://localhost:5173

# Push notifications via ntfy.sh (optional — alerts when Gmail disconnects or a scan fails)
# Pick a private/unguessable topic name and subscribe to it in the ntfy mobile app
NTFY_TOPIC=
