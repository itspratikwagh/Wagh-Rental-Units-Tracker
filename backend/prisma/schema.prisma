generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id          String    @id @default(uuid())
  description String
  amount      Float
  date        DateTime
  category    String
  propertyId  String
  tenantId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  Property    Property  @relation(fields: [propertyId], references: [id])
  Tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model Payment {
  id            String    @id @default(uuid())
  tenantId      String
  amount        Float
  date          DateTime
  paymentMethod String
  status        String    @default("completed")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  Tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

model Property {
  id                 String    @id @default(uuid())
  name               String
  address            String
  type               String
  units              Int
  purchasePrice      Float?
  purchaseDate       DateTime?
  downPaymentPct     Float?
  closingCosts       Float?
  originalMortgage   Float?
  mortgageRate       Float?
  currentMortgageBal Float?
  currentMarketValue Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  deletedAt          DateTime?
  Expense            Expense[]
  Tenant             Tenant[]
}

model Tenant {
  id         String    @id @default(uuid())
  name       String
  email      String
  phone      String
  propertyId String
  rentAmount Float
  leaseStart DateTime
  leaseEnd   DateTime
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  deletedAt  DateTime?
  Expense    Expense[]
  Payment    Payment[]
  Property   Property  @relation(fields: [propertyId], references: [id])
  TenantDocument TenantDocument[]
}

// Uploaded tenant files (ID scans, signed leases). Stored as bytea in
// Postgres because Railway's container filesystem is ephemeral.
model TenantDocument {
  id         String   @id @default(uuid())
  tenantId   String
  kind       String   @default("other") // "id" | "lease" | "other"
  filename   String
  mimeType   String
  sizeBytes  Int
  data       Bytes
  uploadedAt DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

// One row per reminder actually sent — the unique dedupeKey makes reminder
// runs idempotent across restarts and manual re-triggers.
// rent:    rent:{tenantId}:{YYYY-MM}
// renewal: renewal:{tenantId}:{leaseEnd YYYY-MM-DD}:{daysBefore}
model ReminderLog {
  id        String   @id @default(uuid())
  type      String   // "rent" | "renewal"
  tenantId  String
  dedupeKey String   @unique
  status    String   @default("sent")
  detail    String?
  sentAt    DateTime @default(now())
}

model PendingTransaction {
  id              String    @id @default(uuid())
  type            String    // "payment" or "expense"
  source          String    // "interac_email" or "utility_email"
  gmailMessageId  String    @unique
  senderName      String?
  senderEmail     String?
  amount          Float
  date            DateTime
  description     String?
  category        String?
  propertyId      String?
  tenantId        String?
  matchConfidence String    // "high", "medium", "none"
  rawEmailSnippet String?
  status          String    @default("pending") // "pending", "approved", "rejected"
  autoApproved    Boolean   @default(false)
  createdRecordType String? // "payment" | "expense" — set on approval, used for undo
  createdRecordId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewedAt      DateTime?
}

model RecurringExpense {
  id          String    @id @default(uuid())
  description String
  amount      Float
  category    String
  propertyId  String
  frequency   String    // "weekly", "monthly"
  dayOfWeek   Int?      // 0=Sun..6=Sat (for weekly)
  dayOfMonth  Int?      // 1-28 (for monthly)
  isActive    Boolean   @default(true)
  lastGenerated DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model GmailSyncState {
  id            String    @id @default(uuid())
  lastHistoryId String?
  lastSyncAt    DateTime?
  refreshToken  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ScannedEmail {
  id             String   @id @default(uuid())
  gmailMessageId String   @unique
  scannedAt      DateTime @default(now())
}

// Teachable sender rules — replaces hard-coded alias maps and skip lists.
// kind "alias": Interac sender name -> tenant name (e.g. spouse pays the rent)
// kind "skip":  outgoing Interac recipients that are personal, not property expenses
model SenderRule {
  id         String   @id @default(uuid())
  kind       String   // "alias" | "skip"
  senderName String
  tenantName String?  // for kind "alias": the tenant this sender pays for
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScanRun {
  id           String    @id @default(uuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  trigger      String    @default("manual") // "manual" | "cron"
  status       String    @default("running") // "running" | "success" | "partial" | "failed"
  totalFetched Int       @default(0)
  newEmails    Int       @default(0)
  payments     Int       @default(0)
  expenses     Int       @default(0)
  autoRejected Int       @default(0)
  autoApproved Int       @default(0)
  errors       String?
}
